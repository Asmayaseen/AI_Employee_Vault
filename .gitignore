# Environment Variables (CRITICAL - Never commit)
.env
.env.*
*.env
!.env.example

# Credentials (CRITICAL - Never commit)
credentials.json
token.json
**/credentials/*.json
**/credentials/*.txt

# API Keys and Secrets
*_secret*
*_password*
*_token*
*_key.txt

# WhatsApp and LinkedIn Session Data (both dotted and non-dotted)
whatsapp_session/
.whatsapp_session/
linkedin_session/
.linkedin_session/
**/whatsapp_session/
**/.whatsapp_session/
**/linkedin_session/
**/.linkedin_session/

# Logs with Potentially Sensitive Data
*.log
Logs/*.log
Logs/*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv

# Node.js (for MCP servers)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary Files
*.tmp
*.temp
.processed_files

# PM2
.pm2/

# Test and Personal Data
**/Inbox/*.txt
**/Inbox/*.pdf
**/Done/*
test_*.md
TEMP_*

# Vault Sensitive Folders (may contain personal data)
AI_Employee_Vault/Needs_Action/*
!AI_Employee_Vault/Needs_Action/.gitkeep
AI_Employee_Vault/Pending_Approval/*
!AI_Employee_Vault/Pending_Approval/.gitkeep
AI_Employee_Vault/Approved/*
!AI_Employee_Vault/Approved/.gitkeep
AI_Employee_Vault/Done/*
!AI_Employee_Vault/Done/.gitkeep
AI_Employee_Vault/Logs/*.json
!AI_Employee_Vault/Logs/.gitkeep

AI_Employee_Vault/Queued_Actions/*
!AI_Employee_Vault/Queued_Actions/.gitkeep

# Next.js build output
AI_Employee_Vault/web-ui/.next/
AI_Employee_Vault/web-ui/node_modules/

# Plans (runtime output — 300+ generated files, not needed in repo)
AI_Employee_Vault/Plans/PLAN_*.md

# Debug screenshots from Playwright
AI_Employee_Vault/Watchers/debug_*.png

# Runtime state files
AI_Employee_Vault/.processed_linkedin
AI_Employee_Vault/Rejected/
AI_Employee_Vault/Signals/
AI_Employee_Vault/Updates/
AI_Employee_Vault/In_Progress/
AI_Employee_Vault/Logs/alerts/
AI_Employee_Vault/Logs/health/

# Keep folder structure but not contents
!**/.gitkeep
*.png
*.jpg
