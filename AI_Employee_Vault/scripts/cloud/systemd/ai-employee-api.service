[Unit]
Description=AI Employee API (Flask)
After=network.target

[Service]
Type=simple
User=ai-employee
Group=ai-employee
WorkingDirectory=/opt/ai-employee
EnvironmentFile=/etc/ai-employee/env
Environment=DRY_RUN=false
Environment=AGENT_MODE=draft_only
Environment=AGENT_NAME=cloud
ExecStart=/opt/ai-employee/venv/bin/python app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-employee-api

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ai-employee

[Install]
WantedBy=multi-user.target
